{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  "include": [
    "apps/desktop/src",
    "shared",
    "exercises",
    "vitest.config.ts",
    "playwright.config.ts",
    "e2e"
  ]
}
